# FAZA 9: onnxruntime-node (odvisnost @huggingface/transformers) ima install skripto,
# ki prenese ~100 MB naravnih binarnih datotek z CDN-ja. Ta vezava ni potrebna za
# brskalnik (tam se uporablja onnxruntime-web/WASM) in je redno povzročala
# nedeterministične napake pri `npm ci` v CI (ETIMEDOUT). Zato onemogočimo
# nameščanje skript, ki prenašajo binarne artefakte.
ignore-scripts=true
